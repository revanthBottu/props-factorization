But they may want to compute eigenvectors manually; need to compute eigenvectors of tridiagonal matrix, then multiply.

Let's craft final answer:

def lanczos(H, k):
    n = H.shape[0]
    v = np.zeros((n, k+1))
    alpha = np.zeros(k)
    beta = np.zeros(k+1)
    v[:,0] = np.random.rand(n)
    v[:,0] /= np.linalg.norm(v[:,0])
    w = H @ v[:,0]
    alpha[0] = np.dot(v[:,0], w)
    w -= alpha[0] * v[:,0]
    for j in range(1, k):
        beta[j] = np.linalg.norm(w)
        v[:,j] = w / beta[j]
        w = H @ v[:,j]
        alpha[j] = np.dot(v[:,j], w)
        w -= alpha[j] * v[:,j] + beta[j] * v[:,j-1]
    T = np.diag(alpha) + np.diag(beta[1:k], 1) + np.diag(beta[1:k], -1)
    eigvals, eigvecs = np.linalg.eigh(T)
    eigenvectors = v[:,:k] @ eigvecs
    return eigvals, eigenvectors

Now compute:

lam, vec = lanczos(H, 6)
print(lam)   # approx [-2,-1,-1,1,1,2]
print(vec.T @ vec)   # identity

